# Toolchain
common --extra_toolchains=@llvm//:all

# Use C++23
common --cxxopt=-std=c++23

# Enable thinLTO
common:thin_lto --features=thin_lto
common:thin_lto --copt=-Wno-unused-command-line-argument

# Enable tcmalloc
common --custom_malloc=@tcmalloc//tcmalloc

# Disable warnings for all external compilations.
common --per_file_copt=external/.*\.(c|cc|cpp|cxx)$@-w
common --host_per_file_copt=external/.*\.(c|cc|cpp|cxx)$@-w
