load("//bazel/cuda/private:settings.bzl", "archs_flag")

package(default_visibility = ["//visibility:public"])

# Build for Hopper and Blackwell by default.
# Override with --//bazel/cuda:archs=... or at the per-target level.
archs_flag(
    name = "archs",
    build_setting_default = [
        "sm_90a",
        "sm_100a",
        "sm_103a",
    ],
)
