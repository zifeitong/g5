load("//bazel/cuda/private:settings.bzl", "archs_flag")

package(default_visibility = ["//visibility:public"])

# Hopper and Blackwell. The a suffix enables the arch-specific features
# CUTLASS and FlashAttention need; plain sm_90 cannot use wgmma or TMA.
# Override with --//bazel/cuda:archs=... or per target.
archs_flag(
    name = "archs",
    build_setting_default = [
        "sm_90a",
        "sm_100a",
    ],
)
