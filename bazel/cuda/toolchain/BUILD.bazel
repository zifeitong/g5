load(":cuda_toolchain.bzl", "cuda_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

cuda_toolchain(
    name = "nvcc_toolchain",
    compile_args = [
        "--expt-relaxed-constexpr",
        "--extended-lambda",
    ],
    headers = ["@cuda_toolkit//:headers"],
    nvcc = "@cuda_toolkit//:bin/nvcc",
    toolkit_files = ["@cuda_toolkit//:toolkit_files"],
)

[
    toolchain(
        name = "nvcc_linux_{}".format(cpu),
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:{}".format(cpu),
        ],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:{}".format(cpu),
        ],
        toolchain = ":nvcc_toolchain",
        toolchain_type = ":toolchain_type",
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]
