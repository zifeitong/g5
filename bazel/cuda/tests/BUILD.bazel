load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel/cuda:defs.bzl", "cuda_library", "requires_cuda")

cuda_library(
    name = "saxpy",
    srcs = ["saxpy.cu"],
    hdrs = ["saxpy.cuh"],
)

cuda_library(
    name = "thrust_sort",
    srcs = ["thrust_sort.cu"],
)

# A cuda_library with no srcs: device helpers for dependents to inline.
cuda_library(
    name = "device_ops",
    hdrs = ["device_ops.cuh"],
)

# Depends on device_ops for headers only, and takes a define, so this covers
# cuda_library -> cuda_library header propagation into an nvcc compile plus
# the defines attribute. scaled_add.cu #errors if the define goes missing.
cuda_library(
    name = "scaled_add",
    srcs = ["scaled_add.cu"],
    hdrs = ["scaled_add.cuh"],
    defines = ['SCALED_ADD_TAG=\\"scaled_add\\"'],
    deps = [":device_ops"],
)

cuda_library(
    name = "flash_attn",
    srcs = ["flash_attn.cu"],
    hdrs = ["flash_attn.cuh"],
)

cc_binary(
    name = "saxpy_smoke",
    srcs = ["saxpy_main.cc"],
    target_compatible_with = requires_cuda(),
    deps = [
        ":saxpy",
        "@cuda_sdk//:cudart_static",
    ],
)

cc_binary(
    name = "flash_attn_smoke",
    srcs = ["flash_attn_main.cc"],
    target_compatible_with = requires_cuda(),
    deps = [
        ":flash_attn",
        "@cuda_sdk//:cudart_static",
    ],
)
