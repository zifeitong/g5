# libstdc++ platforms for CUDA builds; nvcc cannot parse libc++ headers.
# Selected by --config=cuda. See ../README.md.

package(default_visibility = ["//visibility:public"])

[
    platform(
        name = "linux_{}".format(cpu),
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:{}".format(cpu),
            "@llvm//constraints/cxxstdlib:libstdcxx.14.2.0",
            "@llvm//constraints/libc:gnu.2.28",
        ],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]
