# libstdc++ platform for CUDA builds; nvcc cannot parse libc++ headers.
# Selected by --config=cuda. See ../README.md. The CPU comes from the host,
# since the toolchains require exec arch to equal target arch.

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux",
    constraint_values = [
        "@platforms//os:linux",
        "@llvm//constraints/cxxstdlib:libstdcxx.14.2.0",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)
