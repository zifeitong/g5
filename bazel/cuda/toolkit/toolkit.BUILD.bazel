# CUDA {CUDA_VERSION}. Generated from bazel/cuda/toolkit/toolkit.BUILD.bazel.
# Flat layout; target names follow hermeticbuild/cuda-toolkit.

load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["bin/nvcc"])

# nvcc.profile resolves tools and data relative to the driver; declare the tree.
filegroup(
    name = "toolkit_files",
    srcs = glob(
        [
            "bin/**",
            "include/**",
            "lib/**",
            "nvvm/**",
        ],
        allow_empty = False,
    ),
)

cc_library(
    name = "headers",
    hdrs = glob(["include/**"]),
    # Host compiles need CUDA 13's separate CCCL include directory.
    includes = [
        "include",
        "include/cccl",
    ],
)

cc_import(
    name = "cudart_static_library",
    static_library = "lib/libcudart_static.a",
    deps = [":headers"],
)

cc_import(
    name = "cudadevrt_static_library",
    static_library = "lib/libcudadevrt.a",
    deps = [":headers"],
)

cc_import(
    name = "culibos_static_library",
    static_library = "lib/libculibos.a",
    deps = [":headers"],
)

# Link-time stub; the installed driver supplies libcuda.so.1 at runtime.
cc_import(
    name = "cuda_driver_stub",
    interface_library = "lib/stubs/libcuda.so",
    system_provided = 1,
    deps = [":headers"],
)

# Static CUDART; the installed driver is still required. Sharing kernel stubs
# across DSOs needs a consistent runtime (see README).
cc_library(
    name = "cudart_static",
    linkopts = ["-lrt"],
    deps = [
        ":cuda_driver_stub",
        ":cudadevrt_static_library",
        ":cudart_static_library",
        ":culibos_static_library",
    ],
)
